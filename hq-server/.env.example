# HealthQueue+ Server — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ── Database ──────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hqplus?retryWrites=true&w=majority

# ── Security ──────────────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Chatbot — OpenAI (Mode 2) ─────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# Uses gpt-4o-mini — fast and cost-effective for chatbot use
# If not set, the server falls back to keyword-based FAQ matching
OPENAI_API_KEY=sk-...

# ── Chatbot — Rasa (Mode 1, optional) ────────────────────────────
# If set, Rasa takes priority over OpenAI
# RASA_SERVER_URL=http://localhost:5005
